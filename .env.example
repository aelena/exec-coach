# BYOK for LOCAL DEVELOPMENT and personal builds only.
# Copy to .env.local and fill in the providers you use. Whatever is present is offered in the app.
#
# WARNING: Vite inlines VITE_* values into the JavaScript bundle. Never publish a build made with
# keys set here: `npm run build` refuses to run in that case unless ALLOW_KEYS_IN_BUNDLE=1.
# For a hosted copy of the app, leave this empty and paste your key in Settings instead.

# Anthropic (Claude)
VITE_ANTHROPIC_API_KEY=
# VITE_ANTHROPIC_ACTOR_MODEL=claude-haiku-5-5
# VITE_ANTHROPIC_COACH_MODEL=claude-opus-5-5

# OpenAI (ChatGPT models)
VITE_OPENAI_API_KEY=
# VITE_OPENAI_MODEL=gpt-5.6-sol

# Google Gemini
VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-3.6-flash

# Any OpenAI-compatible endpoint (for example a local model server). The key is optional.
# VITE_CUSTOM_BASE_URL=http://localhost:11434/v1
# VITE_CUSTOM_API_KEY=
# VITE_CUSTOM_MODEL=

# Which provider to preselect when several keys are present: anthropic | openai | gemini | custom
# VITE_DEFAULT_PROVIDER=anthropic
